{
  "name": "deprecation-cop",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Shows deprecated calls used by the editor and installed packages.",
  "keywords": [
    "warning",
    "diagnostics",
    "legacy",
    "api",
    "deprecated"
  ],
  "repository": "https://github.com/lumine-code/deprecation-cop",
  "bugs": {
    "url": "https://github.com/lumine-code/deprecation-cop/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "menus",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^2.0.0": "consumeStatusBar"
      }
    }
  },
  "deserializers": {
    "DeprecationCopView": "deserializeDeprecationCopView"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#d6670187657f33e109570f4dc749bf42b99a0c33",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#a83059c83b18585c9cc8644c4ede87fe64856111",
    "@lumine-code/grim": "github:lumine-code/grim#b00f8680762c12b8c28ca0d9f75c55dd5483d61f",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#b93d01acfb57ce4e40296a7de2ef2dcc1f6442f5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.4"
    }
  }
}
