{
  "name": "deprecation-cop",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Shows deprecated calls used by the editor and installed packages.",
  "keywords": [
    "warning",
    "diagnostics",
    "legacy",
    "api",
    "deprecated"
  ],
  "repository": "https://github.com/lumine-code/deprecation-cop",
  "bugs": {
    "url": "https://github.com/lumine-code/deprecation-cop/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "deserializers": {
    "DeprecationCopView": "deserializeDeprecationCopView"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#a823441dcf10e786f36915f88422fd0c95d33374",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#83486ac8a670adb4381a9d4e2df3eb999f670ad1",
    "@lumine-code/grim": "github:lumine-code/grim#2947941b12eb63cdb9c08169f01ebb735283f222",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#1577303f839c11bd8d83d7fbe3cef8dd9219bfbb"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
