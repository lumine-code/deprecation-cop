{
  "name": "deprecation-cop",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Shows deprecated calls used by the editor and installed packages.",
  "keywords": [
    "warning",
    "diagnostics",
    "legacy",
    "api",
    "deprecated"
  ],
  "repository": "https://github.com/lumine-code/deprecation-cop",
  "bugs": {
    "url": "https://github.com/lumine-code/deprecation-cop/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "deserializers": {
    "DeprecationCopView": "deserializeDeprecationCopView"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#730d47e10f6d655c010f2880186a3a60ed0c73b0",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#016145716ab8ec3cb331053f447fda95eb0fb66a",
    "@lumine-code/grim": "github:lumine-code/grim#957af9896ff2f99904f90671f0c163869d7f1f5d",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#91b7e3c91435ee2aa57819d5dd5ce215264224dc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
